{
  "name": "mes-scans",
  "version": "0.0.0",
  "private": true,
  "description": "Extension Firefox qui regroupe tes scans et retient le chapitre où tu en es",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "npx web-ext lint --source-dir extension --self-hosted",
    "build": "npx web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "start": "npx web-ext run --source-dir extension"
  },
  "engines": {
    "node": ">=20"
  }
}
